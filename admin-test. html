<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>اختبار تسجيل دخول الأدمين</title>
<style>
  body{font-family:sans-serif; background:#FBF6F1; padding:24px; color:#2A1E22;}
  h2{color:#5C1F2E;}
  input{display:block; width:100%; max-width:340px; padding:10px; margin:8px 0; border-radius:8px; border:1px solid #ccc;}
  button{padding:10px 18px; border-radius:8px; border:none; background:#5C1F2E; color:#fff; font-size:15px; margin:6px 6px 6px 0; cursor:pointer;}
  #log{background:#111; color:#0f0; padding:14px; border-radius:8px; margin-top:20px; font-family:monospace; font-size:12.5px; white-space:pre-wrap; max-height:400px; overflow:auto;}
</style>
</head>
<body>
  <h2>🔧 صفحة اختبار تسجيل دخول الأدمين</h2>
  <p>هاد الصفحة معزولة على المتجر بالكامل — كتخدم فقط على تسجيل الدخول، باش نشوفو رسالة الخطأ الحقيقية والكاملة بلا ما تختفي.</p>

  <input id="email" type="email" placeholder="البريد الإلكتروني">
  <input id="password" type="password" placeholder="كلمة السر">
  <button id="btn-password">تسجيل الدخول بالبريد وكلمة السر</button>
  <button id="btn-google">تسجيل الدخول بـ Google</button>
  <button id="btn-clear">مسح السجل</button>

  <div id="log">جاهز... اضغطي على أحد الأزرار فوق.</div>

<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-auth-compat.js"></script>
<script>
const FIREBASE_CONFIG = {
  apiKey: "AIzaSyABy2RRSCFfzV9ZULn8us77jpXf-g9r_cU",
  authDomain: "anoutha-style-75aeb.firebaseapp.com",
  projectId: "anoutha-style-75aeb",
  storageBucket: "anoutha-style-75aeb.firebasestorage.app",
  messagingSenderId: "751301536925",
  appId: "1:751301536925:web:47bea090a3354a6f50f874"
};
firebase.initializeApp(FIREBASE_CONFIG);
const auth = firebase.auth();

const logEl = document.getElementById('log');
function log(msg){
  logEl.textContent += '\n' + msg;
  logEl.scrollTop = logEl.scrollHeight;
}

log('✅ Firebase تم تهيئته');
log('📍 authDomain: ' + FIREBASE_CONFIG.authDomain);
log('📍 الرابط الحالي: ' + window.location.href);

document.getElementById('btn-clear').addEventListener('click', ()=>{ logEl.textContent = 'تم المسح...'; });

document.getElementById('btn-password').addEventListener('click', async ()=>{
  const email = document.getElementById('email').value.trim();
  const password = document.getElementById('password').value;
  log('\n--- محاولة تسجيل الدخول بالبريد وكلمة السر ---');
  log('البريد: ' + email);
  try{
    const result = await auth.signInWithEmailAndPassword(email, password);
    log('✅✅✅ نجح تسجيل الدخول!');
    log('المستخدم: ' + result.user.email);
    log('UID: ' + result.user.uid);
  }catch(e){
    log('❌ فشل تسجيل الدخول');
    log('الكود: ' + e.code);
    log('الرسالة الكاملة: ' + e.message);
  }
});

document.getElementById('btn-google').addEventListener('click', async ()=>{
  log('\n--- محاولة تسجيل الدخول بـ Google ---');
  const provider = new firebase.auth.GoogleAuthProvider();
  try{
    const result = await auth.signInWithPopup(provider);
    log('✅✅✅ نجح تسجيل الدخول!');
    log('المستخدم: ' + result.user.email);
  }catch(e){
    log('❌ فشلت النافذة المنبثقة (popup)');
    log('الكود: ' + e.code);
    log('الرسالة: ' + e.message);
    log('...جاري تجربة التوجيه (redirect) بدلها');
    try{
      await auth.signInWithRedirect(provider);
    }catch(e2){
      log('❌ فشل التوجيه أيضاً');
      log('الكود: ' + e2.code);
      log('الرسالة الكاملة: ' + e2.message);
    }
  }
});

auth.getRedirectResult().then(result=>{
  if(result && result.user){
    log('✅✅✅ نجح تسجيل الدخول عبر التوجيه!');
    log('المستخدم: ' + result.user.email);
  }
}).catch(e=>{
  if(e.code) log('❌ خطأ في نتيجة التوجيه: ' + e.code + ' — ' + e.message);
});

auth.onAuthStateChanged(user=>{
  if(user) log('🔔 onAuthStateChanged: مسجلة الدخول كـ ' + user.email);
});
</script>
</body>
</html>
